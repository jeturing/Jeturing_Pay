{
  "name": "@stripe/ui-extension-sdk",
  "version": "2.2.1",
  "description": "The suite of functionality available to UI extensions in Stripe Tailor apps",
  "author": "Stripe, Inc.",
  "license": "MIT",
  "scripts": {
    "build": "$npm_execpath tsm build && type yalc &>/dev/null || exit 0 && cd ./dist && yalc push --changed",
    "release": "$npm_execpath run tsm release",
    "bind-all": "$npm_execpath run tsm bind-all",
    "clean": "rm -r ./dist",
    "integrity": "yarn-integrity",
    "test": "jest --watchAll"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@remote-ui/react": "^4.4.2",
    "@remote-ui/testing": "^1.3.6",
    "@types/stylis": "^4.0.2",
    "invariant": "^2.2.4",
    "react": "^17.0.2",
    "stripe": "^8.174.0"
  },
  "peerDependencies": {
    "@remote-ui/rpc": "^1.2.5"
  },
  "devDependencies": {
    "@sail/ui": "^27.2.0",
    "@stripe-internal/npm-publish": "^4.1.0",
    "@stripe-internal/tailor-dashboard-components": "^1.3.5",
    "@stripe-internal/tailor-tsm": "0.3.5",
    "@stripe-internal/typescriptify": "^0.6.2",
    "@stripe-internal/yarn-integrity": "^0.0.96",
    "@types/invariant": "^2.2.35",
    "@types/jest": "^27.0.3",
    "@types/react-reconciler": "^0.26.1",
    "chokidar": "^3.5.1",
    "flowgen": "^1.14.1",
    "fs-extra": "^10.0.0",
    "jest": "^27.4.4",
    "jest-junit": "^13.0.0",
    "ts-expect": "^1.3.0",
    "ts-jest": "^27.1.2",
    "tsc-alias": "^1.3.7",
    "typescript": "^4.5.0-dev.20211206"
  },
  "keywords": [
    "stripe",
    "dashboard",
    "extensions",
    "sdk",
    "tailor"
  ]
}