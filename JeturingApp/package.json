{
  "name": "jeturing-pay",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": ">=18 <22"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "docs": "npm run docs:generate && npm run docs:diagrams",
    "docs:generate": "typedoc --out docs/api-reference src",
    "docs:diagrams": "mkdir -p docs/diagrams && node scripts/generate-diagrams.js",
    "build:dev": "eas build --profile development --platform all",
    "build:preview": "eas build --profile preview --platform all",
    "build:production": "eas build --profile production --platform all",
    "build:android": "eas build --platform android --profile production",
    "build:android:apk": "eas build --platform android --profile production-apk",
    "build:ios": "eas build --platform ios --profile production",
    "build:all": "eas build --platform all --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:all": "eas submit --platform all --profile production",
    "update:preview": "eas update --branch preview --message",
    "update:production": "eas update --branch production --message",
    "test": "jest",
    "test:e2e": "detox test --configuration ios.sim.debug",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/config-plugins": "^8.0.0",
    "@react-native-async-storage/async-storage": "2.1.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/stack": "^7.0.0",
    "@stripe/stripe-react-native": "^0.38.6",
    "axios": "^1.7.0",
    "expo": "^52.0.0",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "~0.13.0",
    "expo-clipboard": "~7.0.0",
    "expo-dev-client": "~5.0.4",
    "expo-font": "~13.0.4",
    "expo-linear-gradient": "~14.0.1",
    "expo-linking": "~7.0.3",
    "expo-local-authentication": "~15.0.2",
    "expo-secure-store": "~14.0.1",
    "expo-sharing": "~13.0.0",
    "lottie-react-native": "^6.7.2",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.14.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "^15.8.0",
    "sentry-expo": "^7.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.12",
    "@types/react-native": "~0.73.0",
    "typescript": "^5.3.0",
    "typedoc": "^0.26.0",
    "@mermaid-js/mermaid-cli": "^11.0.0",
    "node-plantuml": "^0.9.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "detox": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.56.0",
    "eas-cli": "^16.28.0"
  },
  "overrides": {
    "@sentry/react-native": "5.36.0",
    "@sentry/browser": "7.119.2",
    "@sentry/react": "7.119.2",
    "@sentry/integrations": "7.119.2",
    "@sentry/core": "7.119.2",
    "@sentry/hub": "7.119.2",
    "@sentry/types": "7.119.2",
    "@sentry/utils": "7.119.2",
    "node-forge": "1.3.3"
  },
  "private": true
}
