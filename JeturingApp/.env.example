# Jeturing Pay - Environment Variables
# Copy this file to .env and customize as needed

# ============================================
# API Configuration
# ============================================
EXPO_PUBLIC_API_URL=https://api-001.sajet.us
EXPO_PUBLIC_API_KEY=your-api-key-here

# ============================================
# Stripe Configuration
# ============================================
# Production keys (replace with your live keys)
EXPO_PUBLIC_STRIPE_PK=pk_live_your_key_here

# Development keys (for testing)
# EXPO_PUBLIC_STRIPE_PK=pk_test_dDfTWCF7FwlZ1yKqMKYf9Jqx00cjTF5EpC

# ============================================
# Feature Flags - Build Time Configuration
# ============================================
# Copy values to .env to override defaults
# All flags default to false unless specified

# Core Payment Features
EXPO_PUBLIC_FF_ENABLE_TAP_TO_PAY=true
EXPO_PUBLIC_FF_ENABLE_PAYMENT_LINKS=true
EXPO_PUBLIC_FF_ENABLE_QR_PAYMENTS=true
EXPO_PUBLIC_FF_ENABLE_RECURRING_PAYMENTS=false
EXPO_PUBLIC_FF_ENABLE_TIPPING=true

# Terminal & Hardware
EXPO_PUBLIC_FF_ENABLE_TERMINAL_READERS=true
EXPO_PUBLIC_FF_ENABLE_SIMULATED_READERS=false

# Customer Management
EXPO_PUBLIC_FF_ENABLE_CUSTOMER_LOOKUP=true
EXPO_PUBLIC_FF_ENABLE_CUSTOMER_INVOICES=true

# UI & Experience
EXPO_PUBLIC_FF_ENABLE_DARK_MODE=false
EXPO_PUBLIC_FF_ENABLE_ANIMATIONS=true
EXPO_PUBLIC_FF_ENABLE_BIOMETRIC_AUTH=true

# Analytics & Monitoring
EXPO_PUBLIC_FF_ENABLE_SENTRY=true
EXPO_PUBLIC_FF_ENABLE_ANALYTICS=true
EXPO_PUBLIC_FF_ENABLE_CRASH_REPORTING=true

# Developer Tools
EXPO_PUBLIC_FF_ENABLE_DEBUG_MODE=false
EXPO_PUBLIC_FF_ENABLE_MOCK_DATA=false
EXPO_PUBLIC_FF_ENABLE_API_LOGGING=false

# Onboarding
EXPO_PUBLIC_FF_ENABLE_SELF_ONBOARDING=true
EXPO_PUBLIC_FF_ENABLE_EXPRESS_ONBOARDING=true

# MPOS Features
EXPO_PUBLIC_FF_ENABLE_MPOS_TRANSACTIONS=true
EXPO_PUBLIC_FF_ENABLE_MPOS_REFUNDS=true

# App Configuration
EXPO_PUBLIC_FF_API_VERSION=2.5.0
EXPO_PUBLIC_FF_MIN_APP_VERSION=1.0.0
EXPO_PUBLIC_FF_MAINTENANCE_MODE=false
EXPO_PUBLIC_FF_MAINTENANCE_MESSAGE=

# ============================================
# EAS Build Configuration
# ============================================
# EAS_BUILD_PROFILE=development | preview | production
# EAS_BUILD_PLATFORM=ios | android | all

# ============================================
# Debug Options
# ============================================
# Enable React Native debugger
# EXPO_DEBUG=true

# Enable detailed Stripe logs
# STRIPE_DEBUG=true
