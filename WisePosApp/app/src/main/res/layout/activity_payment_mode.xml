<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/background_light">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_payment_mode"
            android:textSize="24sp"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textSize="18sp"
            android:textColor="?attr/colorPrimary"
            android:layout_marginTop="12dp" />

    </LinearLayout>

    <!-- Payment Modes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Manual Mode -->
            <RadioButton
                android:id="@+id/rb_manual"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/manual_mode"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:checked="true" />

            <!-- Tap to Pay -->
            <RadioButton
                android:id="@+id/rb_tap_to_pay"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/tap_to_pay_mode"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp" />

            <!-- QR Code -->
            <RadioButton
                android:id="@+id/rb_qr_code"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/qr_code_mode"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp" />

            <!-- Payment Link -->
            <RadioButton
                android:id="@+id/rb_payment_link"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/payment_link_mode"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp" />

        </RadioGroup>

    </LinearLayout>

    <!-- Footer Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_continue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/continue_btn"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:backgroundTint="?attr/colorPrimary"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/cancel_btn"
            android:textSize="16sp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>
