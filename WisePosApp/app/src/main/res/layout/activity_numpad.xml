<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background_light">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/amount_to_charge"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/tv_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00"
            android:textSize="56sp"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- Numpad Grid 3x4 -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="3"
        android:rowCount="4"
        android:layout_margin="16dp"
        android:alignmentMode="alignBounds"
        android:columnOrderPreserved="false">

        <!-- Números 1-3 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_num_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:text="1"
            android:textSize="24sp"
            android:textColor="?attr/colorOnSurface"
            app:backgroundTint="?attr/colorSurfaceVariant"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_num_2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:text="2"
            android:textSize="24sp"
            android:textColor="?attr/colorOnSurface"
            app:backgroundTint="?attr/colorSurfaceVariant"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_num_3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_column="2"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:text="3"
            android:textSize="24sp"
            android:textColor="?attr/colorOnSurface"
            app:backgroundTint="?attr/colorSurfaceVariant"
            app:cornerRadius="12dp" />

        <!-- Números 4-6 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_num_4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:text="4"
            android:textSize="24sp"
            android:textColor="?attr/colorOnSurface"
            app:backgroundTint="?attr/colorSurfaceVariant"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_num_5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:text="5"
            android:textSize="24sp"
            android:textColor="?attr/colorOnSurface"
            app:backgroundTint="?attr/colorSurfaceVariant"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_num_6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_column="2"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:text="6"
            android:textSize="24sp"
            android:textColor="?attr/colorOnSurface"
            app:backgroundTint="?attr/colorSurfaceVariant"
            app:cornerRadius="12dp" />

        <!-- Números 7-9 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_num_7"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="2"
            android:layout_column="0"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:text="7"
            android:textSize="24sp"
            android:textColor="?attr/colorOnSurface"
            app:backgroundTint="?attr/colorSurfaceVariant"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_num_8"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="2"
            android:layout_column="1"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:text="8"
            android:textSize="24sp"
            android:textColor="?attr/colorOnSurface"
            app:backgroundTint="?attr/colorSurfaceVariant"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_num_9"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="2"
            android:layout_column="2"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:text="9"
            android:textSize="24sp"
            android:textColor="?attr/colorOnSurface"
            app:backgroundTint="?attr/colorSurfaceVariant"
            app:cornerRadius="12dp" />

        <!-- Decimal, 0, Backspace -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_decimal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="3"
            android:layout_column="0"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:text="."
            android:textSize="24sp"
            android:textColor="?attr/colorOnSurface"
            app:backgroundTint="?attr/colorSurfaceVariant"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_num_0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="3"
            android:layout_column="1"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:text="0"
            android:textSize="24sp"
            android:textColor="?attr/colorOnSurface"
            app:backgroundTint="?attr/colorSurfaceVariant"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_backspace"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="3"
            android:layout_column="2"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:text="←"
            android:textSize="24sp"
            android:textColor="?attr/colorOnSurface"
            app:backgroundTint="?attr/colorError"
            app:cornerRadius="12dp" />

    </GridLayout>

    <!-- Footer Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_continue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/continue_btn"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:backgroundTint="?attr/colorPrimary" />

    </LinearLayout>

</LinearLayout>
